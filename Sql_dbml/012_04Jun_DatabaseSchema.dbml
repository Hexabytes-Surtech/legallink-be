Ref "consultation_request_matter_id_fkey":"matter"."matter_id" < "consultation_request"."matter_id"

Ref "consultations_advocate_id_fkey":"advocates"."id" < "consultations"."advocate_id" [delete: restrict]

Ref "consultations_citizen_id_fkey":"users"."id" < "consultations"."citizen_id" [delete: restrict]

Ref "consultations_matter_id_fkey":"matters"."id" < "consultations"."matter_id" [delete: restrict]

Ref "conversation_message_matter_id_fkey":"matter"."matter_id" < "conversation_message"."matter_id"

Ref "conversation_message_request_id_fkey":"consultation_request"."request_id" < "conversation_message"."request_id"

