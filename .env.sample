# Server Port
PORT=4000

# Database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# CORS
CORS_ORIGIN=http://localhost:3000

# Public frontend origin used to build deep links inside transactional emails
# (e.g. the "View the request" button advocates tap from their notification mail).
# Falls back to the first CORS_ORIGIN entry, then http://localhost:3000, if unset.
FRONTEND_URL=http://localhost:3000

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# JWT — access token (short-lived, 1 day)
JWT_ACCESS_SECRET=change_this_to_a_long_random_string
JWT_ACCESS_EXPIRES_IN=1d

# JWT — refresh token (long-lived, 7 days)
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# Resend (email OTP)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── AI ───────────────────────────────────────────────────────────────────────
# Gemini (Google AI Studio) — paste your API key here to activate real AI.
# Without a key, the backend falls back to the keyword-based mock.
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional external AI microservice (tried after Gemini, before mock).
# Leave blank if not using one.
AI_SERVICE_URL=

# ── WebRTC 1:1 calling (video/voice) ──────────────────────────────────────────
# TURN relay for NAT traversal (needed for the minority of users on restrictive
# networks). Create a FREE account at https://www.metered.ca (no card needed),
# then paste a key + your subdomain below. EITHER key works here — the app API Key
# or the account Secret Key (auto-detected). Leave BLANK to run STUN-only — calls
# still connect on most networks, just without the relay fallback.
METERED_API_KEY=
METERED_DOMAIN=your_subdomain.metered.live
# Optional static TURN fallback (e.g. self-hosted coturn / ExpressTURN). Leave blank if unused.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Web Push (incoming-call notifications when the app is closed) ──────────────
# VAPID keys for Web Push. Generate a pair with:  npx web-push generate-vapid-keys
# PUBLIC key is safe to expose; PRIVATE key is a SECRET (never commit). Leave BLANK
# to disable push (in-app ring still works while the app is open). SUBJECT is a
# mailto: or https: URL identifying the sender.
VAPID_SUBJECT=mailto:you@yourdomain.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
