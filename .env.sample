
DATABASE_URL=postgresql://neondb_owner:REDACTED_NEON_PASSWORD@ep-broad-rain-ao59q5er-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── AI Pipeline ────────────────────────────────────────────────────────────
# Dispatch order: Gemini (if GEMINI_API_KEY set) → AI_SERVICE_URL → keyword mock.
#
# Gemini (Google AI Studio) — paste your API key here to activate real AI.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=REDACTED_GEMINI_KEY
GEMINI_MODEL=gemini-flash-latest

# Optional external AI microservice (FastAPI, etc). Tried after Gemini, before mock.
AI_SERVICE_URL=

# Server Port
PORT=4000

# CORS
CORS_ORIGIN=http://localhost:3000

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=dam72rcl0
CLOUDINARY_API_KEY=REDACTED_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=REDACTED_CLOUDINARY_SECRET

# JWT — access token (short-lived, 1 day)
JWT_ACCESS_SECRET=REDACTED_JWT_SECRET
JWT_ACCESS_EXPIRES_IN=1d
# JWT — refresh token (long-lived, 7 days)
JWT_REFRESH_SECRET=REDACTED_JWT_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# Resend (email OTP)
RESEND_API_KEY=REDACTED_RESEND_KEY
RESEND_FROM_EMAIL=legal-link@hexabytes.tech

# ── WebRTC 1:1 calling (video/voice) ──────────────────────────────────────────
# TURN relay for NAT traversal (needed for the minority of users on restrictive
# networks). Create a FREE account at https://www.metered.ca (no card needed),
# then paste a key + your subdomain below. EITHER key works here — the app API Key
# or the account Secret Key (auto-detected). Leave BLANK to run STUN-only — calls
# still connect on most networks, just without the relay fallback.
METERED_API_KEY=
METERED_DOMAIN=your_subdomain.metered.live
# Optional static TURN fallback (e.g. self-hosted coturn / ExpressTURN). Leave blank if unused.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Web Push (incoming-call notifications when the app is closed) ──────────────
# VAPID keys for Web Push. Generate a pair with:  npx web-push generate-vapid-keys
# PUBLIC key is safe to expose; PRIVATE key is a SECRET (never commit). Leave BLANK
# to disable push (in-app ring still works while the app is open). SUBJECT is a
# mailto: or https: URL identifying the sender.
VAPID_SUBJECT=mailto:you@yourdomain.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Test-only OTP bypass ───────────────────────────────────────────────────────
# Test-only: bypass OTP verification when the submitted code equals BYPASS_OTP_CODE.
# MUST be disabled in production. The user still has to /auth/login first
# (so the user row needs an active otp_code/otp_expires_at — bypass only skips bcrypt compare).
BYPASS_OTP_FOR_TESTING=true
BYPASS_OTP_CODE=000000

# ── Razorpay (TEST mode) — advocate SaaS subscription billing ──────────────────
# Get TEST keys at Razorpay Dashboard → Settings → API Keys (switch to Test Mode).
# KEY_ID is safe to expose to the browser; KEY_SECRET is a SECRET (never commit real keys).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional — only needed if you wire the payment.captured webhook (Dashboard → Webhooks).
RAZORPAY_WEBHOOK_SECRET=
